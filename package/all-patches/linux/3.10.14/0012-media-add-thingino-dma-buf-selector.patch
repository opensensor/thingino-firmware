--- a/arch/mips/xburst/soc-t23/common/platform.c
+++ b/arch/mips/xburst/soc-t23/common/platform.c
@@ -67,6 +67,3 @@ struct jz_gpio_func_def platform_devio_array[] = {
-#ifndef CONFIG_VIDEO_V4L2
-	MCLK_PORTA,
-#endif
-#ifdef CONFIG_SOC_MCLK
+#if !defined(CONFIG_VIDEO_V4L2) || defined(CONFIG_SOC_MCLK) || defined(CONFIG_THINGINO_EXTERNAL_SENSOR_MCLK)
 	MCLK_PORTA,
 #endif
diff --git a/arch/mips/xburst/soc-t30/common/platform.c b/arch/mips/xburst/soc-t30/common/platform.c
--- a/arch/mips/xburst/soc-t30/common/platform.c
+++ b/arch/mips/xburst/soc-t30/common/platform.c
@@ -52,6 +52,3 @@ struct jz_gpio_func_def platform_devio_array[] = {
-#ifndef CONFIG_VIDEO_V4L2
-	MCLK_PORTA,
-#endif
-#ifdef CONFIG_SOC_MCLK
+#if !defined(CONFIG_VIDEO_V4L2) || defined(CONFIG_SOC_MCLK) || defined(CONFIG_THINGINO_EXTERNAL_SENSOR_MCLK)
 	MCLK_PORTA,
 #endif
diff --git a/arch/mips/xburst/soc-t31/common/platform.c b/arch/mips/xburst/soc-t31/common/platform.c
--- a/arch/mips/xburst/soc-t31/common/platform.c
+++ b/arch/mips/xburst/soc-t31/common/platform.c
@@ -57,6 +57,3 @@ struct jz_gpio_func_def platform_devio_array[] = {
-#ifndef CONFIG_VIDEO_V4L2
-	MCLK_PORTA,
-#endif
-#ifdef CONFIG_SOC_MCLK
+#if !defined(CONFIG_VIDEO_V4L2) || defined(CONFIG_SOC_MCLK) || defined(CONFIG_THINGINO_EXTERNAL_SENSOR_MCLK)
 	MCLK_PORTA,
 #endif
