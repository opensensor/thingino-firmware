config BR2_PACKAGE_LIGHTNVR
	bool "lightnvr"
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_4_4
	select BR2_PACKAGE_GO2RTC
	select BR2_PACKAGE_HOST_NODEJS
	select BR2_PACKAGE_THINGINO_FFMPEG
	select BR2_PACKAGE_SQLITE
	select BR2_PACKAGE_CJSON
	default n
	help
	  Experimental NVR for Ingenic SoC's.
	  Automatically enables FFmpeg with staging installation
	  and required libraries for CMake-based builds.

config BR2_PACKAGE_LIGHTNVR_SOD
	bool "SOD object detection"
	depends on BR2_PACKAGE_LIGHTNVR
	help
	  Build and install LightNVR's SOD object-detection engine.

config BR2_PACKAGE_LIGHTNVR_SOD_INGENIC_MXU
	bool "Ingenic MXU2/MXU3 acceleration"
	depends on BR2_PACKAGE_LIGHTNVR_SOD
	depends on BR2_mips || BR2_mipsel
	default y
	help
	  Enable runtime-dispatched Ingenic SIMD acceleration for SOD.
